<%#
  TEC Batch — Batch details tab after upload.
  Locals: caption, nav
%>
<% caption = (defined?(caption) && caption) ? caption : "TEC Batch — Batch details" %>
<% nav = (defined?(nav) && nav) ? nav : :local_authority %>
<% body = [
  '<div class="bf-kv" title="State"><span class="bf-kv__key">State</span><span class="bf-kv__value" style="width: 52%"></span></div>',
  '<div class="bf-kv" title="File identifier"><span class="bf-kv__key">File identifier</span><span class="bf-kv__value" style="width: 40%"></span></div>',
  '<div class="bf-kv" title="Batch identifier"><span class="bf-kv__key">Batch identifier</span><span class="bf-kv__value" style="width: 36%"></span></div>',
  '<div class="bf-kv" title="Local authority"><span class="bf-kv__key">Local authority</span><span class="bf-kv__value" style="width: 58%"></span></div>',
  '<div class="bf-kv" title="Submitter email"><span class="bf-kv__key">Submitter email</span><span class="bf-kv__value" style="width: 64%"></span></div>',
  '<div class="bf-kv" title="Batch type"><span class="bf-kv__key">Batch type</span><span class="bf-kv__value" style="width: 34%"></span></div>',
  '<div class="bf-kv" title="Number of PCNs in batch"><span class="bf-kv__key">Number of PCNs in batch</span><span class="bf-kv__value" style="width: 18%"></span></div>',
  '<div class="bf-kv" title="Number of PCNs processed"><span class="bf-kv__key">Number of PCNs processed</span><span class="bf-kv__value" style="width: 16%"></span></div>',
  '<div class="bf-kv" title="Fees due"><span class="bf-kv__key">Fees due</span><span class="bf-kv__value" style="width: 22%"></span></div>',
  '<div class="bf-kv" title="Received via"><span class="bf-kv__key">Received via</span><span class="bf-kv__value" style="width: 24%"></span></div>'
].map { |part| part.to_s.strip }.reject(&:empty?).join.gsub(/\n[ \t]*\n/, "\n") %>
<%= partial "partials/blockframe/page", locals: { caption: caption, active: :case_details, tabs_variant: :batch, nav: nav, body: body } %>
