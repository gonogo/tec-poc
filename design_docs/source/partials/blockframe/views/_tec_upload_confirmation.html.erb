<%#
  Upload batch file — submit confirmation.
  Locals: caption, nav
%>
<% caption = (defined?(caption) && caption) ? caption : "Confirmation — Registration submitted" %>
<% nav = (defined?(nav) && nav) ? nav : :local_authority %>
<% body = [
  '<div class="bf-form bf-form--full">',
  partial("partials/blockframe/text", locals: { size: :title, label: "Registration submitted", callout: true }),
  '<div class="bf-copy" title="Case number">Case number: 1788-2660-5799-1856</div>',
  '<div class="bf-copy" title="Overnight processing">Your registration batch have been submitted and will be processed overnight. 23 PCNs have not been included in the submission and are included in an exception report which you can access from the batch case.</div>',
  "</div>"
].map { |part| part.to_s.strip }.reject(&:empty?).join.gsub(/\n[ \t]*\n/, "\n") %>
<%= partial "partials/blockframe/page", locals: { caption: caption, show_tabs: false, nav: nav, body: body } %>
