<%#
  Upload batch file — validationResults (Some data cannot be processed).
  Locals: caption, nav
%>
<% caption = (defined?(caption) && caption) ? caption : "Event — Some data cannot be processed" %>
<% nav = (defined?(nav) && nav) ? nav : :local_authority %>
<% body = [
  '<div class="bf-form bf-form--full">',
  partial("partials/blockframe/text", locals: { size: :title, label: "Some data cannot be processed", callout: true }),
  '<div class="bf-copy" title="Invalid PCN data">Invalid PCN data</div>',
  '<div class="bf-copy" title="Invalid PCN count">3 PCNs you’ve uploaded contain invalid data. They cannot be processed.</div>',
  '<div class="bf-copy" title="Removed PCNs intro">These PCNs will be removed from this batch:</div>',
  '<div class="bf-table" title="PCNs removed from this batch">',
  '<div class="bf-table__row" title="PCN row"><span class="bf-table__cell"><span class="bf-table__value bf-table__value--callout" title="PCN">BS41291736</span></span><span class="bf-table__cell"><span class="bf-table__value bf-table__value--callout" title="Reason">Missing name and address</span></span></div>',
  '<div class="bf-table__row" title="PCN row"><span class="bf-table__cell"><span class="bf-table__value bf-table__value--callout" title="PCN">BS10568629</span></span><span class="bf-table__cell"><span class="bf-table__value bf-table__value--callout" title="Reason">Incorrect characters in row</span></span></div>',
  '<div class="bf-table__row" title="PCN row"><span class="bf-table__cell"><span class="bf-table__value bf-table__value--callout" title="PCN">BS73125084</span></span><span class="bf-table__cell"><span class="bf-table__value bf-table__value--callout" title="Reason">Duplicated PCN</span></span></div>',
  "</div>",
  '<div class="bf-copy" title="Exception report">You will be sent an exception report containing all PCNs which have been removed.</div>',
  '<div class="bf-actions"><span class="bf-action bf-action--secondary" title="Previous"></span><span class="bf-action bf-action--primary" title="Continue"></span></div>',
  "</div>"
].map { |part| part.to_s.strip }.reject(&:empty?).join.gsub(/\n[ \t]*\n/, "\n") %>
<%= partial "partials/blockframe/page", locals: { caption: caption, show_tabs: false, nav: nav, body: body } %>
