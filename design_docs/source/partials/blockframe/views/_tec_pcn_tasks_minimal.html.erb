<%#
  TEC PCN — Tasks tab, Minimal example.
  Only Manage cases, case number, and the Validate application form task card have text.
  That task card is fully callout-styled.
%>
<% caption = (defined?(caption) && caption) ? caption : "Example — Minimal" %>
<% body = [
  partial("partials/blockframe/text", locals: { size: :title, label: nil }),
  partial("partials/blockframe/task_card", locals: {
    task_title: "Validate application form",
    priority: "High",
    due_date: "13 September 2026",
    assignee: "tec-demo@test.com",
    next_steps: true,
    extra_next_steps: true,
    next_step_label: "Validate application form",
    next_step_label_2: "Edit application",
    callout_section: true
  }),
  partial("partials/blockframe/task_card", locals: {
    blank: true,
    manage_only: true
  }),
  partial("partials/blockframe/task_card", locals: {
    blank: true,
    next_steps: false
  })
].join %>
<%= partial "partials/blockframe/page", locals: {
  caption: caption,
  active: :tasks,
  minimal: true,
  body: body
} %>
