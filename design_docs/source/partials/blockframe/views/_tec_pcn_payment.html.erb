<%#
  TEC PCN — Payment History tab.
%>
<% caption = (defined?(caption) && caption) ? caption : "TEC PCN — Payment History" %>
<% body = [
  partial("partials/blockframe/text", locals: { size: :title, label: "Payment History" }),
  partial("partials/blockframe/text", locals: { size: :line, label: "Payment transactions" }),
  partial("partials/blockframe/text", locals: { size: :line, label: "Transaction row" }),
  partial("partials/blockframe/text", locals: { size: :medium, label: "Amount / status" }),
  partial("partials/blockframe/text", locals: { size: :short, label: "Payment reference" }),
  partial("partials/blockframe/text", locals: { size: :line, label: "Payment date" })
].join %>
<%= partial "partials/blockframe/page", locals: { caption: caption, active: :payment, body: body } %>
