<%#
  TEC PCN — Tasks tab.
%>
<% caption = (defined?(caption) && caption) ? caption : "TEC PCN — Tasks" %>
<% highlight = (defined?(highlight) && highlight) ? highlight : false %>
<% body = [
  partial("partials/blockframe/text", locals: { size: :title, label: "Active tasks heading" }),
  partial("partials/blockframe/task_card", locals: {
    task_title: "Validate application form",
    next_steps: true,
    highlight: highlight,
    extra_next_steps: true,
    next_step_label: "Next steps: Validate application form",
    next_step_label_2: "Next steps: Edit application"
  }),
  partial("partials/blockframe/task_card", locals: {
    task_title: "Review issued case (unassigned)",
    manage_only: true
  }),
  partial("partials/blockframe/task_card", locals: {
    task_title: "Check respondent details (assigned to other clerk)",
    next_steps: false
  })
].join %>
<%= partial "partials/blockframe/page", locals: { caption: caption, active: :tasks, body: body } %>
