<%#
  Upload batch file — statementOfTruth.
  Locals: caption, nav
%>
<% caption = (defined?(caption) && caption) ? caption : "Event — Statement of truth" %>
<% nav = (defined?(nav) && nav) ? nav : :local_authority %>
<% body = [
  '<div class="bf-form bf-form--full">',
  partial("partials/blockframe/text", locals: { size: :title, label: "Statement of truth", callout: true }),
  '<div class="bf-copy" title="Contempt of court warning">I understand that proceedings for contempt of court may be brought against anyone who makes, or causes to be made, a false statement in a document verified by a statement of truth without an honest belief in its truth.</div>',
  partial("partials/blockframe/field", locals: {
    type: :multi_select,
    label: "Statement of truth",
    title: "Statement of truth — checkbox",
    options: ["I believe that the facts stated in this batch request are true."],
    selected: -1,
    callout: true
  }),
  '<div class="bf-actions"><span class="bf-action bf-action--secondary" title="Previous"></span><span class="bf-action bf-action--primary" title="Continue"></span></div>',
  "</div>"
].map { |part| part.to_s.strip }.reject(&:empty?).join.gsub(/\n[ \t]*\n/, "\n") %>
<%= partial "partials/blockframe/page", locals: { caption: caption, show_tabs: false, nav: nav, body: body } %>
