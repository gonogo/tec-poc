<%#
  TEC PCN — Case details tab (Registration / Application / Time extension).
%>
<% caption = (defined?(caption) && caption) ? caption : "TEC PCN — Case details" %>
<% body = [
  '<div class="bf-section" title="Registration section">',
  partial("partials/blockframe/text", locals: { size: :title, label: "Registration section heading" }),
  partial("partials/blockframe/text", locals: { size: :line, label: "File identifier / Batch identifier" }),
  partial("partials/blockframe/text", locals: { size: :medium, label: "Penalty charge number" }),
  partial("partials/blockframe/text", locals: { size: :line, label: "Local authority / Respondent details" }),
  partial("partials/blockframe/text", locals: { size: :short, label: "Vehicle registration number" }),
  partial("partials/blockframe/text", locals: { size: :medium, label: "Payment status / Registration document" }),
  "</div>",
  '<div class="bf-section" title="Application section">',
  partial("partials/blockframe/text", locals: { size: :title, label: "Application section heading (e.g. Witness statement)" }),
  partial("partials/blockframe/text", locals: { size: :short, label: "Form validation result" }),
  partial("partials/blockframe/text", locals: { size: :line, label: "Application date received / type" }),
  partial("partials/blockframe/text", locals: { size: :medium, label: "Applicant / address fields" }),
  partial("partials/blockframe/text", locals: { size: :line, label: "Declaration / conditional fields" }),
  partial("partials/blockframe/text", locals: { size: :short, label: "PCN / VRN on application" }),
  "</div>",
  '<div class="bf-section" title="Time extension section">',
  partial("partials/blockframe/text", locals: { size: :title, label: "Time extension section heading (TE7 / PE2)" }),
  partial("partials/blockframe/text", locals: { size: :line, label: "Form validation result (shared)" }),
  partial("partials/blockframe/text", locals: { size: :medium, label: "Permission sought / reasons given" }),
  partial("partials/blockframe/text", locals: { size: :short, label: "Signed and dated" }),
  "</div>"
].join %>
<%= partial "partials/blockframe/page", locals: { caption: caption, active: :case_details, body: body } %>
