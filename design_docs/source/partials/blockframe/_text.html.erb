<%#
  Single text bar — empty = rectangle; with label = text in the bar colour.
  Locals:
    size    — :title | :line | :short | :medium (default :line)
    label   — visible text and hovertext
    callout — true → bf-text--callout (GOV.UK black / white on dark chrome)
%>
<% size = (defined?(size) && size) ? size : :line %>
<% label = (defined?(label) && label) ? label : nil %>
<% callout = (defined?(callout) && callout) ? callout : false %>
<span class="bf-text bf-text--<%= size %><%= ' bf-text--callout' if callout %>"<% if label %> title="<%= escape_html(label) %>"<% end %>><%= label %></span>
