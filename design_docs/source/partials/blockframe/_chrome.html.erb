<%#
  ExUI Manage Cases chrome above the tab strip.
  Locals:
    show_case_header — case number + Next step / Go (default true)
    minimal — only Manage cases + case number have text; other chrome is empty bars
%>
<% show_case_header = (defined?(show_case_header) && !show_case_header.nil?) ? show_case_header : true %>
<% minimal = (defined?(minimal) && minimal) ? minimal : false %>
<div class="bf-exui"><div class="bf-exui__bar"><div class="bf-exui__bar-row"><span class="bf-exui__brand" title="Manage cases">Manage cases</span><span class="bf-exui__sign-out" title="Sign out"><%= "Sign out" unless minimal %></span></div><div class="bf-exui__bar-row bf-exui__bar-row--nav"><div class="bf-exui__nav"><span class="bf-exui__nav-link" title="Create case"><%= "Create case" unless minimal %></span><span class="bf-exui__nav-link" title="Upload batch file"><%= "Upload batch file" unless minimal %></span></div><div class="bf-exui__search"><span class="bf-exui__search-input" title="Case reference input"></span><span class="bf-exui__search-btn" title="Find"></span></div></div></div><% if show_case_header %><div class="bf-exui__case"><span class="bf-exui__case-number" title="Case number">Case number: 1788-2660-5799-1856</span><div class="bf-exui__next-step"><span class="bf-exui__next-step-select" title="Next step dropdown"></span><span class="bf-exui__go" title="Go"></span></div></div><% end %></div>
