<%#
  ExUI Manage Cases chrome above the tab strip (sized/positioned to match the live UI).
  Locals: show_case_header — case number + Next step / Go (default true)
  Output must stay unindented so Markdown does not treat it as a code block.
  Text spans show copy; buttons, inputs, phase tag, and dropdown stay as blocks.
%>
<% show_case_header = (defined?(show_case_header) && !show_case_header.nil?) ? show_case_header : true %>
<div class="bf-exui"><div class="bf-exui__bar"><div class="bf-exui__bar-row"><span class="bf-exui__brand" title="Manage cases">Manage cases</span><span class="bf-exui__sign-out" title="Sign out">Sign out</span></div><div class="bf-exui__bar-row bf-exui__bar-row--nav"><div class="bf-exui__nav"><span class="bf-exui__nav-link" title="Create case">Create case</span><span class="bf-exui__nav-link" title="Upload batch file">Upload batch file</span></div><div class="bf-exui__search"><span class="bf-exui__search-input" title="Case reference input"></span><span class="bf-exui__search-btn" title="Find"></span></div></div></div><div class="bf-exui__phase"><span class="bf-exui__phase-tag" title="BETA phase tag"></span><span class="bf-exui__phase-text" title="Phase banner supporting text">This is a new service — your feedback will help us to improve it.</span></div><% if show_case_header %><div class="bf-exui__case"><span class="bf-exui__case-number" title="Case number">Case number: 1788-2660-5799-1856</span><div class="bf-exui__next-step"><span class="bf-exui__next-step-select" title="Next step dropdown"></span><span class="bf-exui__go" title="Go"></span></div></div><% end %></div>
