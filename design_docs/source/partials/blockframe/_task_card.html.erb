<%#
  Prototype Tasks card (Manage / Next steps).
  Locals:
    task_title        — hovertext for task name bar
    next_steps        — true to show Next steps link bars
    highlight         — true to outline Next steps (journey focus)
    manage_only       — true for unassigned-style Manage links without Next steps
    extra_next_steps  — second Next steps link bar
    next_step_label   — hovertext for primary Next steps link
    next_step_label_2 — hovertext for second Next steps link
%>
<% task_title = (defined?(task_title) && task_title) ? task_title : "Task name" %>
<% next_steps = (defined?(next_steps) && next_steps) ? next_steps : false %>
<% highlight = (defined?(highlight) && highlight) ? highlight : false %>
<% manage_only = (defined?(manage_only) && manage_only) ? manage_only : false %>
<% extra_next_steps = (defined?(extra_next_steps) && extra_next_steps) ? extra_next_steps : false %>
<% next_step_label = (defined?(next_step_label) && next_step_label) ? next_step_label : "Next steps" %>
<% next_step_label_2 = (defined?(next_step_label_2) && next_step_label_2) ? next_step_label_2 : "Next steps" %>
<div class="bf-task" title="Task card: <%= escape_html(task_title) %>"><%= partial "partials/blockframe/text", locals: { size: :title, label: task_title } %><div class="bf-task__row"><span class="bf-task__key" title="Priority (label)"></span><span class="bf-task__value" title="Priority value"></span></div><div class="bf-task__row"><span class="bf-task__key" title="Due date (label)"></span><span class="bf-task__value" title="Due date value"></span></div><div class="bf-task__row"><span class="bf-task__key" title="Assigned to (label)"></span><span class="bf-task__value" title="Assignee"></span></div><div class="bf-task__row"><span class="bf-task__key" title="Manage (label)"></span><div class="bf-task__links"><% if manage_only %><span class="bf-action bf-action--link" title="Manage: Assign to me"></span><% else %><span class="bf-action bf-action--link" title="Manage: Reassign"></span><span class="bf-action bf-action--link" title="Manage: Unassign"></span><% end %></div></div><% if next_steps %><div class="bf-task__row"><span class="bf-task__key" title="Next steps (label)"></span><div class="bf-task__links"><span class="bf-action bf-action--link<%= ' bf-action--highlight' if highlight %>" title="<%= escape_html(next_step_label) %>"></span><% if extra_next_steps %><span class="bf-action bf-action--link" title="<%= escape_html(next_step_label_2) %>"></span><% end %></div></div><% end %></div>
